DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=flowmodel

JWT_SECRET=your-secret-jwt-key-here

# Rate Limiter - защита от брутфорса логина
# Максимальное количество попыток входа
LOGIN_MAX_ATTEMPTS=5
# Окно подсчёта попыток (в минутах)
LOGIN_WINDOW_MINUTES=15
# Время блокировки после превышения (в минутах)
LOGIN_BLOCK_MINUTES=15